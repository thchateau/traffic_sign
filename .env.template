# Environment Configuration Template
# Copy this file to .env and fill in your API keys

# Mapillary API Configuration
# Get your token from: https://www.mapillary.com/dashboard/developers
MAPILLARY_ACCESS_TOKEN=your_mapillary_access_token_here

# Optional: Model cache directory
# Uncomment and set to specify where models should be cached
# MODEL_CACHE_DIR=/path/to/model/cache

# Optional: Device selection
# Uncomment to force CPU or CUDA
# DEVICE=cuda
# DEVICE=cpu
